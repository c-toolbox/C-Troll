{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Visual Studio 2026 x64 (vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "deploy",
      "inherits": "windows-msvc",
      "displayName": "Deployment build",
      "binaryDir": "${sourceDir}/build-deploy"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    }
  ]
}
